<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FreshUI</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AetherUseApi>true</AetherUseApi>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gum, the UI toolkit of FreshUI's Gum screens (src/Gum); packaged with the mod. -->
    <PackageReference Include="Gum.FNA" Version="2026.11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared host assembly (asset types); not packaged. -->
    <Reference Include="ReLogic" HintPath="$(AetherClientDirectory)/ReLogic.dll" Private="false" />
  </ItemGroup>

  <Import Project="build/Aether.Mod.targets" />
</Project>
