<Project>
  <PropertyGroup>
    <ModManifestPath>$(MSBuildProjectDirectory)/aether.mod.json</ModManifestPath>
    <AetherRoot Condition="'$(AETHER_ROOT)' != ''">$(AETHER_ROOT)</AetherRoot>
    <AetherRoot Condition="'$(AetherRoot)' == '' And Exists('$(MSBuildProjectDirectory)/.aether-root')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/.aether-root').Trim())</AetherRoot>
    <AetherRoot Condition="'$(AetherRoot)' == ''">.aether/client</AetherRoot>
    <AetherClientConfiguration Condition="'$(AETHER_CONFIGURATION)' != ''">$(AETHER_CONFIGURATION)</AetherClientConfiguration>
    <AetherClientConfiguration Condition="'$(AetherClientConfiguration)' == ''">Debug</AetherClientConfiguration>
    <AetherRootPath>$([System.IO.Path]::GetFullPath('$(AetherRoot)', '$(MSBuildProjectDirectory)'))</AetherRootPath>
    <AetherBootstrapPath>$(AetherRootPath)/client/Bootstrap</AetherBootstrapPath>
    <AetherBootstrapPath Condition="!Exists('$(AetherBootstrapPath)/Aether.Bootstrap.csproj') And Exists('$(AetherRootPath)/Bootstrap/Aether.Bootstrap.csproj')">$(AetherRootPath)/Bootstrap</AetherBootstrapPath>
    <AetherClientDirectory Condition="'$(AetherClientDirectory)' == ''">$(AetherBootstrapPath)/bin/$(AetherClientConfiguration)/net10.0</AetherClientDirectory>
    <AetherApiSourceDirectory>$(AetherRootPath)/client/Api</AetherApiSourceDirectory>
    <AetherBuildApi Condition="'$(AetherUseApi)' == 'true' And '$(AetherApiDirectory)' == ''">true</AetherBuildApi>
    <AetherApiDirectory Condition="'$(AetherBuildApi)' == 'true'">$(AetherApiSourceDirectory)/bin/$(AetherClientConfiguration)/net10.0</AetherApiDirectory>
    <AetherSaveDirectory Condition="'$(AetherSaveDirectory)' == ''">$(MSBuildProjectDirectory)/.aether/saves</AetherSaveDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Aether.Api" HintPath="$(AetherApiDirectory)/Aether.Api.dll" Private="false"
      Condition="'$(AetherUseApi)' == 'true'" />
    <Reference Include="Aether.Modding" HintPath="$(AetherClientDirectory)/Aether.Modding.dll" Private="false" />
    <Reference Include="FNA" HintPath="$(AetherClientDirectory)/FNA.dll" Private="false" />
    <Reference Include="Terraria" HintPath="$(AetherClientDirectory)/Terraria.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateAetherConfiguration">
    <Error Condition="'$(AetherClientConfiguration)' != 'Debug' And '$(AetherClientConfiguration)' != 'Release'"
      Text="Set AETHER_CONFIGURATION to Debug or Release." />
  </Target>

  <Target Name="ValidateAetherReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="ValidateAetherConfiguration">
    <Error Condition="'$(AetherClientDirectory)' == '' Or !Exists('$(AetherClientDirectory)/Aether.Modding.dll') Or !Exists('$(AetherClientDirectory)/Terraria.dll') Or !Exists('$(AetherClientDirectory)/FNA.dll')"
      Text="Run the mod launcher with setup to prepare the local Aether client. For an external checkout, build that client first." />
    <Error Condition="'$(AetherUseApi)' == 'true' And !Exists('$(AetherApiDirectory)/Aether.Api.dll')"
      Text="Run the mod launcher with setup to build Aether.Api.dll, or set AetherApiDirectory to a matching API build." />
    <Error Condition="!Exists('$(ModManifestPath)')" Text="Missing aether.mod.json." />
    <PropertyGroup>
      <ModManifest>$([System.IO.File]::ReadAllText('$(ModManifestPath)'))</ModManifest>
      <ModId>$([System.Text.RegularExpressions.Regex]::Match('$(ModManifest)', '\x22id\x22\s*:\s*\x22([^\x22]*)\x22').Groups[1].Value)</ModId>
      <ModEntryAssembly>$([System.Text.RegularExpressions.Regex]::Match('$(ModManifest)', '\x22assembly\x22\s*:\s*\x22([^\x22]*)\x22').Groups[1].Value)</ModEntryAssembly>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModId)', '^[a-z][a-z0-9_.-]{0,63}$'))"
      Text="The mod ID in aether.mod.json must start with a lowercase ASCII letter and contain only lowercase letters, digits, periods, underscores, or hyphens (64 characters maximum)." />
    <Error Condition="'$(ModEntryAssembly)' != '$(TargetFileName)'"
      Text="aether.mod.json points to '$(ModEntryAssembly)', but the project builds '$(TargetFileName)'." />
  </Target>

  <Target Name="ResolveModManifest" DependsOnTargets="ValidateAetherReferences">
    <!-- Encode the leading @ so dotnet new substitutes the tokens in the manifest only. -->
    <PropertyGroup>
      <ResolveAetherVersion>$(ModManifest.Contains('&#64;aether-version@'))</ResolveAetherVersion>
      <ResolveTerrariaVersion>$(ModManifest.Contains('&#64;terraria-version@'))</ResolveTerrariaVersion>
    </PropertyGroup>
    <Error Condition="'$(ResolveAetherVersion)' == 'True' And !Exists('$(AetherClientDirectory)/Aether.version')"
      Text="Rebuild the selected Aether client to generate Aether.version, or set an explicit aether dependency in aether.mod.json." />
    <GetAssemblyIdentity AssemblyFiles="$(AetherClientDirectory)/Terraria.dll" Condition="'$(ResolveTerrariaVersion)' == 'True'">
      <Output TaskParameter="Assemblies" ItemName="TerrariaAssemblyIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <ResolvedModManifest>$(ModManifest)</ResolvedModManifest>
      <AetherBuildVersion Condition="'$(ResolveAetherVersion)' == 'True'">$([System.IO.File]::ReadAllText('$(AetherClientDirectory)/Aether.version').Trim())</AetherBuildVersion>
      <TerrariaBuildVersion Condition="'$(ResolveTerrariaVersion)' == 'True'">@(TerrariaAssemblyIdentity->'%(Version)')</TerrariaBuildVersion>
      <ResolvedModManifest Condition="'$(ResolveAetherVersion)' == 'True'">$(ResolvedModManifest.Replace('&#64;aether-version@', '$(AetherBuildVersion)'))</ResolvedModManifest>
      <ResolvedModManifest Condition="'$(ResolveTerrariaVersion)' == 'True'">$(ResolvedModManifest.Replace('&#64;terraria-version@', '$(TerrariaBuildVersion)'))</ResolvedModManifest>
    </PropertyGroup>
  </Target>

  <Target Name="PackMod" DependsOnTargets="Build;ResolveModManifest">
    <PropertyGroup>
      <ModStaging>$(IntermediateOutputPath)mod-package/</ModStaging>
      <ModArchive>$(TargetDir)$(AssemblyName).aethermod</ModArchive>
    </PropertyGroup>
    <RemoveDir Directories="$(ModStaging)" />
    <MakeDir Directories="$(ModStaging)" />
    <WriteLinesToFile File="$(ModStaging)aether.mod.json" Lines="$([MSBuild]::Escape('$(ResolvedModManifest)'))" Overwrite="true" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDepsFilePath)" DestinationFolder="$(ModStaging)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/icon.png" DestinationFolder="$(ModStaging)"
      Condition="Exists('$(MSBuildProjectDirectory)/icon.png')" />
    <ItemGroup>
      <ModResource Include="$(MSBuildProjectDirectory)/resources/**/*" />
      <ModDependency Include="@(ReferenceCopyLocalPaths)"
 />
    </ItemGroup>
    <Copy SourceFiles="@(ModResource)"
      DestinationFiles="@(ModResource->'$(ModStaging)resources/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModDependency)"
      DestinationFiles="@(ModDependency->'$(ModStaging)%(DestinationSubDirectory)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(ModStaging)" DestinationFile="$(ModArchive)" Overwrite="true" />
  </Target>

  <Target Name="PrepareAetherApi" Condition="'$(AetherUseApi)' == 'true'" DependsOnTargets="ValidateAetherConfiguration">
    <Error Condition="'$(AetherBuildApi)' == 'true' And !Exists('$(AetherApiSourceDirectory)/Aether.Api.csproj')"
      Text="The local Aether checkout has no API project. Set AETHER_ROOT to a checkout with the API or set AetherApiDirectory to a matching API build." />
    <Exec Condition="'$(AetherBuildApi)' == 'true'" WorkingDirectory="$(AetherApiSourceDirectory)"
      Command="dotnet build Aether.Api.csproj -c $(AetherClientConfiguration) -t:PackMod" />
    <Error Condition="!Exists('$(AetherApiDirectory)/Aether.Api.dll') Or !Exists('$(AetherApiDirectory)/aether-api.aethermod')"
      Text="AetherApiDirectory must contain Aether.Api.dll and aether-api.aethermod from the matching API build." />
  </Target>

  <Target Name="InstallMod" DependsOnTargets="PrepareAetherApi;PackMod">
    <Copy SourceFiles="$(ModArchive)" DestinationFolder="$(AetherSaveDirectory)/Mods" />
    <Copy SourceFiles="$(AetherApiDirectory)/aether-api.aethermod" DestinationFolder="$(AetherSaveDirectory)/Mods"
      Condition="'$(AetherUseApi)' == 'true'" />
  </Target>
</Project>
