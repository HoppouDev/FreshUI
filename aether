#!/bin/sh
set -eu

prepare_only=false
case "${1:-}" in
    run) shift ;;
    setup) prepare_only=true; shift ;;
    watch)
        # .NET hot reload: dotnet watch builds the mod, then runs this script (the project's RunCommand)
        # with its hot reload agent's startup hook, and sends each saved edit to the game.
        shift
        [ "${1:-}" = -- ] && shift
        mod_root=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
        exec dotnet watch --project "$mod_root/FreshUI.csproj" --non-interactive run -- "$@"
        ;;
esac
case "${1:-}" in
    -h|--help)
        printf '%s\n' 'Usage: ./aether [run | setup | watch] [-- game-args...]' \
            'On first use, clone and build Aether under .aether/client.' \
            'Use setup to prepare the client without starting the game.' \
            'Use watch to run the game with .NET hot reload of the mod (needs the ASP.NET Core runtime).'
        exit 0
        ;;
    --)
        shift
        ;;
esac

configuration=${AETHER_CONFIGURATION:-Debug}
case "$configuration" in
    Debug|Release) ;;
    *)
        printf '%s\n' 'AETHER_CONFIGURATION must be Debug or Release.' >&2
        exit 1
        ;;
esac

mod_root=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
client_root=${AETHER_ROOT:-}
if [ -z "$client_root" ] && [ -f "$mod_root/.aether-root" ]; then
    client_root=$(tr -d '\r' < "$mod_root/.aether-root")
fi

managed=false
if [ -z "$client_root" ]; then
    managed=true
    client_root="$mod_root/.aether/client"
    if [ ! -e "$client_root" ]; then
        mkdir -p "$mod_root/.aether"
        git clone -- "${AETHER_REPOSITORY:-https://github.com/HoppouDev/Aether.git}" "$client_root"
    fi
fi
case "$client_root" in
    /*) ;;
    *) client_root="$mod_root/$client_root" ;;
esac
bootstrap_dir=client/Bootstrap
if [ ! -f "$client_root/$bootstrap_dir/Aether.Bootstrap.csproj" ]; then
    bootstrap_dir=Bootstrap
fi
if [ ! -x "$client_root/aether" ] || [ ! -f "$client_root/$bootstrap_dir/Aether.Bootstrap.csproj" ]; then
    printf '%s\n' 'The Aether checkout needs a mod-capable revision with the bootstrap project.' >&2
    exit 1
fi
client_root=$(CDPATH= cd -- "$client_root" && pwd -P)

client_build="$client_root/$bootstrap_dir/bin/$configuration/net10.0"
save_dir="$mod_root/.aether/saves"

# Under ./aether watch, dotnet watch's hot reload agent is a startup hook for the game only: the
# builds below are .NET processes too, and would take the agent's connection.
startup_hooks=${DOTNET_STARTUP_HOOKS:-}
unset DOTNET_STARTUP_HOOKS

# Built on every run (incremental), so a pulled checkout re-applies its patches and is rebuilt.
if [ "$managed" = true ]; then
    (
        cd "$client_root"
        if [ ! -f src/Terraria/Main.cs ]; then
            ./aether setup
        fi
        if [ "$configuration" = Release ]; then
            ./aether build --release
        else
            ./aether build
        fi
    )
fi
if [ "$prepare_only" = true ]; then
    exec dotnet msbuild "$mod_root" -t:PrepareAetherApi "-p:AetherClientDirectory=$client_build"
fi

dotnet build "$mod_root" -t:InstallMod \
    "-p:AetherClientDirectory=$client_build" "-p:AetherSaveDirectory=$save_dir"

cd "$client_root"
if [ -n "$startup_hooks" ]; then
    export DOTNET_STARTUP_HOOKS="$startup_hooks"
fi
exec ./aether launch --configuration "$configuration" --save-dir "$save_dir" -- "$@"
